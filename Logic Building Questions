using System;
namespace HelloWorld{
public class PrimeNo
{
    public static void Main(string[] args){
        Console.WriteLine("Enter a number:");
        int n = Convert.ToInt32(Console.ReadLine());
        if (n<=1){
            Console.WriteLine("Not prime.");
        }
        bool isPrime = true;
        for(int i = 2; i<=n-1;i++){
            if (n%i == 0){
                isPrime = false;
                break;
            }
        }
            if (isPrime){
                Console.WriteLine("Prime.");
            }else{
                Console.WriteLine("Not prime.");
            }
        }
    }
}

