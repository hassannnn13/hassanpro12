=> Color Changer App
<!DOCTYPE html>
<html>
<head>
  <title>Color Changer App</title>
</head>
<body>
  <h1>Color Changer App</h1>
  <button id="sayBtn">Change Background</button>

  <script>
    let sayBtn = document.getElementById("sayBtn");
    sayBtn.addEventListener("click", function() {
    let colors = [ "lightblue", "lightgreen", "yellow", "red", "pink", "orange" ];
    let randomIndex = Math.floor(Math.random() * colors.length);
    let randomColor = colors[randomIndex];
    document.body.style.backgroundColor = randomColor;
    });
  </script>

</body>
</html>


=> Text Counter App
<!DOCTYPE html>
<html>
<head>
  <title>Text Counter App</title>
</head>
<body>
  <h1>Text Counter App</h1>
  <input type="text" id="content" placeholder="Enter here"/>
  <p id="count"></p>

  <script>
    let content = document.getElementById("content");
    let count = document.getElementById("count");
    content.addEventListener("input", function() {
    let text = content.value;
    let charCount = text.length;
    count.textContent = "Character:" +charCount;
    });
  </script>

</body>
</html>


=> Guess Number App
<!DOCTYPE html>
<html>
<head>
  <title>Guess Number App</title>
</head>
<body>
  <h1>Guess Number App</h1>
  <input type="number" id="num" placeholder="Enter your guess:"/>
  <button id="submit">Submit my guess</button>
  <p id="message"></p>

  <script>
    let num = document.getElementById("num");
    let submit = document.getElementById("submit");
    let message = document.getElementById("message");
    let secretnum = Math.floor(Math.random() * 10) + 1;
    submit.addEventListener("click", function() {
    let guess = Number(num.value);
    if (guess === secretnum){
      message.innerText = "Correct";
    }else if (guess > secretnum){
      message.innerText = "Too high";
    }else{
      message.innerText = "Too low";
    }
    });
  </script>

</body>
</html>


=> Mini Calculator
<!DOCTYPE html>
<html>
<head>
  <title>Mini Calculator</title>
</head>
<body>
  <h1>Mini Calculator</h1>
  <input type="number" id="num1" placeholder="Enter the first number:"/>
  <input type="number" id="num2" placeholder="Enter the second number:"/>
  <button id="add">+</button>
  <button id="subtract">-</button>
  <button id="multiply">*</button>
  <button id="divide">/</button>
  <p id="result"></p>

  <script>
    let add = document.getElementById("add");
    let subtract = document.getElementById("subtract");
    let multiply = document.getElementById("multiply");
    let divide = document.getElementById("divide");
    let result = document.getElementById("result");

    add.addEventListener("click", function(){
    let num1 = Number(document.getElementById("num1").value);
    let num2 = Number(document.getElementById("num2").value);
    result.innerText = "Result: " + (num1 + num2);
    });
    subtract.addEventListener("click", function(){
    let num1 = Number(document.getElementById("num1").value);
    let num2 = Number(document.getElementById("num2").value);
    result.innerText = "Result: " + (num1 - num2);
    });
    multiply.addEventListener("click", function(){
    let num1 = Number(document.getElementById("num1").value);
    let num2 = Number(document.getElementById("num2").value);
    result.innerText = "Result: " + (num1 * num2);
    });
    divide.addEventListener("click", function(){
    let num1 = Number(document.getElementById("num1").value);
    let num2 = Number(document.getElementById("num2").value);
    if (num2 === 0){
      result.innerText = "Can't divide by zero!"
    }else{
    result.innerText = "Result: " + (num1 / num2);
    }
    });
  </script>

</body>
</html>
