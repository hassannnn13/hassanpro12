# Conditional operators: <, >, <=, >=, ==, !=
a = int(input("Enter your age:"))
print("My age is:",a)
print(a>18) # false
print(a<18) # false
print(a>=18) # true
print(a<=18) # true
print(a==18) # true
print(a!=18) # false
if(a>=18):
  print("You can vote") # this space is called indentation which means we are entering the block of code (interview question)
else:
  print("You cannot vote")
