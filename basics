}

Problem:
1.class Car{
public brand : string;
private year : number;

constructor(brand : string, year : number){
this.brand = brand;
this.year = year;
}
getInfo() : string {
return `Brand is ${this.brand} and year is ${this.year}`;
}
setYear(newYear : number) : void{
    if (newYear > 1995){
        this.year = newYear;
    }else{
        console.log("Not valid!");
    }
  }
}
let c = new Car("BMW", 2010);
console.log(c.getInfo());
c.setYear(2004);
console.log(c.getInfo());
c.setYear(1990);


2.class BankAccount{
private balance : number;
constructor(balance : number){
this.balance = balance;
}
deposit(amount : number) : void {
    if (amount > 0){
        this.balance = this.balance + amount;
    }
    else{
        console.log("Unable to deposit.")
    }
}
withdraw(amount : number) : void{
    if (amount <= this.balance){
        this.balance = this.balance - amount;
    }
    else{
        console.log("Unable to withdraw.");
    }
  }
  getBalance() : string{
      return `Balance : ${this.balance}`;
  }
}
let b = new BankAccount(1000);
console.log(b.getBalance());
b.deposit(500);
console.log(b.getBalance());
b.withdraw(1000);
console.log(b.getBalance());
b.withdraw(2000);
