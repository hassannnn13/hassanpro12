Basics:
// Numbers
let age: number = 20;
age = 21;

// Strings
let name: string = "Fatima";
const greeting: string = `Hello, ${name}`;

// Boolean
let isStudent: boolean = true;

// Type inference (TS can guess the type)
let count = 5; 

// Any (turns off checking — avoid when learning)
let whatever: any = "hello";
whatever = 5;

// Unknown (safer than any)
let something: unknown = 10;

// Void — for functions that DON'T return a value
function sayHi(): void {
  console.log("Hi!");
}

// Never — for functions that never finish normally (rare)
function explode(): never {
  throw new Error("boom");
}

