# VARIABLE LENGTH ARGUMENTS
# Example 1
def average(*numbers):
  sum = 0
  for i in numbers:
    sum = sum + i
  print("Average is: ", sum / len(numbers)) # len() is used to find the length of the tuple

average(5, 6, 7, 1) # Average is: 4.75

# Example 2
