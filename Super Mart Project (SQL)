CREATE OR REPLACE VIEW high_loyalty_customers AS
SELECT name, loyalty_points
FROM customers
WHERE loyalty_points >= 50;

CREATE VIEW product_stock_summary AS
SELECT name, quantity,
       CASE 
         WHEN quantity < 20 THEN 'Low Stock'
         WHEN quantity BETWEEN 20 AND 50 THEN 'Medium Stock'
         ELSE 'High Stock'
       END AS stock_status
FROM products;

DELIMITER $$
CREATE PROCEDURE TopPaidEmployees()
BEGIN
  SELECT name, salary
  FROM employees
  WHERE salary = (SELECT MAX(salary) FROM employees);
END $$
DELIMITER ;

SELECT e.name AS employee_name, COUNT(s.sale_id) AS total_sales, SUM(s.total_amount) AS total_amount
FROM sales s
JOIN employees e ON s.employee_id = e.employee_id
GROUP BY e.employee_id
ORDER BY total_amount DESC;

