=> Views => Account => Login.cshtml
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow-lg p-4 rounded-4" style="width: 400px;">
        <h2 class="text-center mb-4">Login</h2>

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label for="Email" class="form-label">Email</label>
                <input type="email" class="form-control" id="Email" name="Email" placeholder="Enter your email" required />
            </div>

            <div class="mb-3">
                <label for="Password" class="form-label">Password</label>
                <input type="password" class="form-control" id="Password" name="Password" placeholder="Enter your password" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-3">Login</button>
        </form>

        <div class="text-center mt-3">
            <p class="mb-0">Don’t have an account? <a asp-controller="Account" asp-action="Register">Register</a></p>
        </div>
    </div>
</div>



=> Views => Account => Register.cshtml
@{
    ViewData["Title"] = "Register";
}

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow-lg p-4 rounded-4" style="width: 400px;">
        <h2 class="text-center mb-4">Register</h2>

        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label for="DisplayName" class="form-label">Full Name</label>
                <input type="text" class="form-control" id="DisplayName" name="DisplayName" placeholder="Enter your name" required />
            </div>

            <div class="mb-3">
                <label for="Email" class="form-label">Email</label>
                <input type="email" class="form-control" id="Email" name="Email" placeholder="Enter your email" required />
            </div>

            <div class="mb-3">
                <label for="Password" class="form-label">Password</label>
                <input type="password" class="form-control" id="Password" name="Password" placeholder="Enter a password" required />
            </div>

            <button type="submit" class="btn btn-success w-100 rounded-3">Register</button>
        </form>

        <div class="text-center mt-3">
            <p class="mb-0">Already have an account? <a asp-controller="Account" asp-action="Login">Login</a></p>
        </div>
    </div>
</div>



=> Views => Home => Index.cshtml
@{
    ViewData["Title"] = "Home";
}
<h2>Welcome</h2>

@if (User.Identity?.IsAuthenticated == true)
{
    <p>Hello @User.Identity.Name! (<a asp-controller="Account" asp-action="Logout" asp-route-returnUrl="/">Logout</a>)</p>
    <p><a asp-action="Secure">Go to Secure Page</a></p>
}
else
{
    <p>You are not signed in. <a asp-controller="Account" asp-action="Login">Login</a> or <a asp-controller="Account" asp-action="Register">Register</a></p>
}



=> Views => Home => Privacy.cshtml
@using System.Security.Claims
@{
    ViewData["Title"] = "Secure";
}
<h2>Secure Page</h2>

<p>This page requires login.</p>
<p>Welcome, @User.FindFirstValue("DisplayName") (@User.Identity.Name)</p>
<p>Your role: @User.FindFirstValue(System.Security.Claims.ClaimTypes.Role)</p>



=> Views => Shared => Layout.cshtml
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Simplelogin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Simplelogin.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span>@User.FindFirst("DisplayName")?.Value</span>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    <button type="submit">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            }

            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Simplelogin</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Simplelogin - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
