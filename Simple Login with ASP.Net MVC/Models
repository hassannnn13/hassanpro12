using System.ComponentModel.DataAnnotations;
namespace SimpleLoginMvc.Models
{
    public class LoginViewModel
    {
        [Required] // you can't this empty otherwise it will show an error
        public string Username { get; set; } = "";
        [Required] 
        [DataType(DataType.Password)] // hides password
        public string Password { get; set; } = "";
        public string? ReturnUrl { get; set; }
    }
}
=> RegisterViewModel.cs
using System.ComponentModel.DataAnnotations;
namespace SimpleLoginMvc.Models
{
    public class RegisterViewModel
    {
        [Required, MinLength(3)] // must be at least 3 characters
        public string Username { get; set; } = "";
        [Required, MinLength(2)] // must be at least 2 characters
        public string DisplayName { get; set; } = "";
        [Required, MinLength(6)] // must be at least 6 characters
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
        [Required, Compare("Password")] // Must match the Password field.
        [DataType(DataType.Password)]
        public string ConfirmPassword { get; set; } = "";
    }
}
