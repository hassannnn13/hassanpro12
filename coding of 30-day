     <li>Pray five times and good islamic man</li>
   </ol>
   </div>
   
   <div class="hobbies">
   <h2>Hobbies</h2>
   <ul class="box">
     <li>Swimming</li>
     <li>Workout</li>
     <li>Sports Activity</li>
   </ul>
   </div>
</div>
<div class="practice">
  <div class="education">
    <h2>Education</h2>
    <p>Matriculation:The Crescent Academy</p>
    <p>College:Commecs College</p>
    <p>University:DHA Suffa University</p>
