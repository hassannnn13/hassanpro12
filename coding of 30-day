  <div class="learning">
    <h2>learning</h2>
  <ol>
    <li>HTML</li>
    <li>CSS & Tailwind CSS</li>
    <li>JavaScript & Angular JS</li>
  </ol>
  </div>
</div>
   <table border ="1" class="tab">
     <tr>
       <th>Meal</th>
