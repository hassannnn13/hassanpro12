<!DOCTYPE html>
<html>
  <head>
    <title>About Me</title>
    <style>
      body {
        background: lightblue url('https://www.w3schools.com/css/img_lights.jpg') no-repeat center center fixed;
        background-size: cover;
        font-family: Arial, sans-serif;
      }

      h1 {
        color: white;
        text-align: center;
        background-color: rgba(255, 255, 255, 0.6); 
        padding: 10px;
        border-radius: 10px;
        font-family: 'Poppins', sans-serif;
        text-decoration: underline;
        text-shadow: 2px 2px 4px black;
      }

      .dump {
        color: green;
      }

      .tab, .tab th, .tab td {
        color: darkblue;
        border: 2px solid black;
        border-collapse: collapse;
        padding: 10px;
        background-color: rgba(255, 255, 255, 0.8); 
      }

      .box {
        width: 200px; 
        padding: 20px;    
        border: 1px solid black; 
        margin: 15px;  
        background-color: rgba(255, 255, 255, 0.7);  
        font-family: Arial,sans-serif;
        line-height: 1.5;
        font-style: italic;
      }

      .hello {
        border: 5px solid black;
        margin:10px;
        padding: 15px;
        width:200px;
        background-color: rgba(0, 0, 0, 0.1); 
        position: relative;
      }

      #about {
        color: red;
      }

      .detail {
        color: green;
        padding: 5px;
      }
      .merge{
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }
      .goals,.hobbies{
        background-color: rgba(255,255,255,0.7);
        padding: 10px;
        border-radius: 10px;
        margin: 10px 0;
      }
      @media (max-width: 768px) {
  .merge {
    grid-template-columns: 1fr; 
  }
}
.practice{
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.education, .learning{
  background-color: rgba(255,255,255,0.6);
  margin: 20px 0;
  border-radius: 20px;
  padding: 10px;
}
@media(max-width: 768px){
  .practice{
  flex-direction: column;
  }
}
@media (max-width: 500px) {
  body {
    font-size: 14px; 
  }
  h1 {
    font-size: 20px;
  }
  .box, .goals, .hobbies, .education, .learning {
    padding: 8px; 
    margin: 5px;
  }
}
input[type="text"],
input[type="email"],
input[type="password"],
textarea,
select {
  width: 250px;
  padding: 8px;
  border: 2px solid gray;
  border-radius: 8px;
  margin: 5px 0;
  transition: border 0.3s ease, box-shadow 0.3s ease;
}
  
  input:focus,
  textarea:focus,
  select:focus{
    border-color: blue;
    box-shadow: 0 0 8px lightblue;
    outline: none;
  }
  input[type="checkbox"]:checked,
input[type="radio"]:checked {
  accent-color: blue;
}
input[type="submit"]{
  background-color: blue;
  color:white;
  padding: 10px 20px;
  border-radius: 10px;
  border: none;
  cursor: pointer;
  transition: background-color 0.3 ease;
}
input[type="submit"]:hover{
  background-color: darkblue;
  transform: scale(1.1);
}
.square{
  width: 100px;
  height: 150px;
  background: blue;
  color: white;
  transition: transform 1s ease, background 1s ease;
}
.square:hover{
  transform: scale(1.5) rotate(45deg);
  background-color: green;
}
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  </head>
  <body>
   <h1>Hassan Idrees</h1>
   <p class="detail">My name is Hassan and I am learning Web development.</p>
<div class="square"></div>
  <div class="merge">
   <div class="goals">
