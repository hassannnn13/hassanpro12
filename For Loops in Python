# for loop
name = "Hassan"
for i in name:
  print(i)
  if(i=="a"):
    print("This is something special!")

colors = ["Red", "Green", "Blue", "Yellow"]
for color in colors:
  print(color)
  for i in color:
    print(i)

# range formula:
for k in range(5):
  print(k + 1) # 0 to 4

for k in range(1, 9):
  print(k) # 1 to 8

for k in range(1, 20001):
  print(k) # 1 to 20000

for k in range(1, 12, 3):
  print(k) # 1 to 11 with 3 difference

for k in range(1, 30, 3):
  print(k) # 1 t0 29 with 3 difference 
