<!DOCTYPE html>
<html>
  <head>
    <title>Hello, World!</title>
  <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
  </head>
  <body>
   <div ng-app="myApp" ng-controller="MainCtrl">
     <h1>Students List</h1>
     <input type="text" ng-model="newStudent" placeholder="Enter your name............"/>
     <button ng-click="addStudent()">Add Student</button>
     
     <ol>
       <li ng-repeat="student in students track by $index">
         
         <span ng-if="!student.editing">{{student.name}}</span>
         
         <input ng-if="student.editing" type="text" ng-model="student.name"/>
         
         <button ng-click="editStudent(student)">{{ student.editing ? "Save" : "Edit"}}</button>
         
         <button ng-click="removeStudent($index)">Remove</button>
       </li>
     </ol>
   </div>
    <script>
      var app = angular.module("myApp",[]);
      app.controller("MainCtrl",function($scope){
        $scope.students = [
          {name : 'Hassan', editing : false},
          {name : 'Hashir', editing : false},
          {name : 'Huzaifa', editing : false},
          {name : 'Hasnain', editing : false},
          {name : 'Abdullah', editing : false}
          ];

       $scope.addStudent = function() {
         if($scope.newStudent){
           $scope.students.push({name : $scope.newStudent, editing : false});
           $scope.newStudent="";
         }
       };

       $scope.removeStudent = function(index){
         $scope.students.splice(index,1);
       };

       $scope.editStudent = function (student){
         student.editing = !student.editing;
       };

      });
    </script>
  </body>
</html>
