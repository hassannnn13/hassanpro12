<!DOCTYPE html>
<html>
<head>
  <title>Day 5 - Sorting & Filtering</title>
  <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
</head>
<body ng-app="myApp" ng-controller="MainCtrl">

  <h2>Student Table</h2>

  <input type="text" ng-model="searchText" placeholder="Search student...">
<div>
  <button ng-click="sortField='name'; reverse=false">Sort by Name ↑</button>
  <button ng-click="sortField='name'; reverse=true">Sort by Name ↓</button>
  <button ng-click="sortField='age'; reverse=false">Sort by Age ↑</button>
  <button ng-click="sortField='age'; reverse=true">Sort by Age ↓</button>
</div>
  <table border="1" cellpadding="5">
    <tr>
      <th>Name</th>
      <th>Age</th>
    </tr>
    <tr ng-repeat="student in students | filter:searchText | orderBy:sortField:reverse">
      <td>{{student.name}}</td>
      <td>{{student.age}}</td>
    </tr>
  </table>
  
<script>
    var app = angular.module("myApp", []);
    app.controller("MainCtrl", function($scope) {
      $scope.students = [
        {name: "Hashir", age: 22},
        {name: "Huzaifa", age: 19},
        {name: "Abdullah", age: 25},
        {name: "Hassan", age: 21}
      ];

      $scope.sortField = 'name';
      $scope.reverse = false;
    });
</script>

</body>
</html>
