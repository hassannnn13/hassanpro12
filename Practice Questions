<!DOCTYPE html>
<html>
<head>
  <title>Day 2 - Directives</title>
  <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
  <style>
    .highlight {
      color: green;
      font-weight: bold;
    }
    .warning {
      color: red;
    }
    .danger{
      color: blue;
    }
  </style>
</head>
<body ng-app="myApp" ng-controller="MainCtrl">

  <h1>AngularJS Directives</h1>

  <p>Hello {{ name | uppercase}}</p>
  <p ng-bind="name"></p>
  <p>{{fee | currency}}</p>

  <button ng-click="toggleList()">Toggle List</button>
  <ul ng-show="showList">
    <li ng-repeat="student in students">
      {{ student | lowercase}}
      </li>
      <button ng-click="removeStudent()" ng-disabled="students.length === 0">Clear All</button>
  </ul>
  <p ng-hide="showList">List is hidden</p>
 
  <input type="text" ng-model="newStudent" placeholder="Add student"/>
  <button ng-click="addStudent()" ng-disabled="!newStudent || students.includes(newStudent)">Add Student</button>
  <div>
  <input type="text" ng-model="searchText" placeholder="Search Here......."/>
  <ul>
    <li ng-repeat="student in students | filter:searchText">
      {{student}}
    </li>
  </ul>
  </div>
  <div>
    <button ng-click="reverse = !reverse">Toggle Order</button>
  <ul>
    <li ng-repeat="student in students | orderBy :' ': reverse ">
      {{student}}
    </li>
  </ul>
  </div>

  <p ng-class="{'highlight': students.length > 3, 'warning': students.length == 0, 'danger' : students.length > 5}">
    Total Students: {{ students.length }}
  </p>
  <p ng-if="students.length == 0 " >No student yet.</p>
  <p ng-if="students.length > 5 " >Too many students.</p>

  <script>
    var app = angular.module("myApp", []);
    app.controller("MainCtrl", function($scope) {
      $scope.name = "Hassan";
      $scope.fee = 2000;
      $scope.students = ["Hashir", "Huzaifa", "Abdullah"];
      $scope.showList = true;

      $scope.toggleList = function() {
        $scope.showList = !$scope.showList;
      };

      $scope.addStudent = function() {
        if ($scope.newStudent) {
          $scope.students.push($scope.newStudent);
          $scope.newStudent = "";
        }
      };
      $scope.removeStudent = function(){
      $scope.students = [];
      }
    });
  </script>
</body>
</html>
